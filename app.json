{
  "expo": {
    "name": "QWatch OSS",
    "slug": "qwatch-pro-oss-native",
    "version": "0.13.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qwatchproossnative",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qwatchproossnative.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "QWatch OSS connects to your smart band over Bluetooth.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF6E5"
      },
      "package": "com.qwatchproossnative.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E5"
        }
      ],
      "expo-status-bar",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "QWatch OSS connects to your smart band over Bluetooth."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFE69A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
